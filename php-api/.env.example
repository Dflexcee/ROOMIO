# Database Configuration
DB_HOST=localhost
DB_NAME=roomio
DB_USER=root
DB_PASS=

# Application URLs
APP_URL=http://localhost/roomio/php-api/public
UPLOAD_BASE_URL=http://localhost/roomio/php-api/uploads
FRONTEND_URL=http://localhost:5173

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Email Configuration
ADMIN_EMAIL=admin@roomio.com
SUPPORT_EMAIL=support@roomio.com
SUPPORT_PHONE=+234 123 456 7890

# Session Configuration
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# App Environment
APP_ENV=development
APP_DEBUG=true
